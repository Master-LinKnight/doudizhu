{
  "name": "doudizhu",
  "version": "0.1.0",
  "private": true,
  "description": "斗地主 — 绝对公平、AI 独立的桌面游戏",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "export-assets": "node export-assets.mjs --pen 斗地主.pen",
    "sync-design": "node sync-design.mjs --pen 斗地主.pen",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron": "npm run build && npm run build:electron && electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@pen.dev/cli": "^0.3.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
